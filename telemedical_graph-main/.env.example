# Oracle connection for the existing JdbcTemplate application.
# Set DB_URL to the actual service configured in your Oracle installation.
DB_URL=jdbc:oracle:thin:@//localhost:1521/<your-service-name>
DB_USERNAME=<your-schema-user>
DB_PASSWORD=<your-local-password>

# Neo4j Desktop Bolt settings for the selected local DBMS/database.
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-local-neo4j-password>
NEO4J_DATABASE=neo4j

FRONTEND_ORIGIN=http://localhost:5173
